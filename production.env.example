# Copy to production.env outside version control. Set real delivery and hosting values.
NODE_ENV=production
DEMO_MODE=false
HOST=0.0.0.0
PORT=4197
DATA_DIR=/data
APP_URL=https://sopeasy.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SOPEasy <noreply@example.com>
# Enable only after source-fidelity review and your provider data agreement.
AI_DISABLED=true
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_MAX_TOKENS=8192
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_MAX_TOKENS=4096
